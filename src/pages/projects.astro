---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects | nahuynh.dev">
  <!-- Navbar -->
  <div
    class="align-left fixed left-0 right-0 top-0 px-5 flex select-none items-center z-40 justify-center py-5 font-bold text-accent sm:px-16 sm:py-12 sm:text-3xl md:text-4xl xl:px-80"
  >
    <span>
      <a
        href="/"
        class="bg-gradient-to-r from-info to-accent bg-clip-text leading-normal text-transparent"
      >
        nahuynh.dev
      </a>
    </span>
    <nav class="ml-auto flex items-center space-x-8">
      <a class="text-accent" href="/projects">projects</a>
      <a href="/Na_Huynh_Resume.pdf" target = "_blank">resume</a>
      <a href="https://github.com/NaHuynh22" target = "_blank">
        <img
          src="/github-mark-white.svg"
          class="h-6 w-6 sm:h-8 sm:w-8"
          alt="Github"
        />
      </a>
      <a href="https://www.linkedin.com/in/na-huynh/" target = "_blank">
        <img
          src="/linkedin.svg"
          class="h-6 w-6 sm:h-8 sm:w-8"
          alt="Github"
        />
      </a>
    </nav>
  </div>

  <!-- Projects Header -->
  <section
    class="flex flex-col items-center justify-center text-center gap-5 px-5 sm:px-16 xl:px-80 pt-32 pb-8"
  >
    <h1 class="text-6xl font-extrabold bg-gradient-to-r from-info to-accent bg-clip-text text-transparent">
      Projects <br> <br>
    </h1>
    <p class="text-lg text-base-content max-w-3xl">
      The following is an overview of my selected projects. For an in-depth report with software
      implementation details and code snippets, check out my full portfolio below.
    </p>
    <a
      href="/projects/Portfolio/portfolio.pdf"
      target="_blank"
      class="text-accent underline hover:text-info transition"
      >View Full Portfolio PDF<br><br><br><br></a
    >
  </section>

  <!-- Project Cards -->
  <section
    class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-8 px-5 sm:px-16 xl:px-80 pb-16 -mt-2"
  >
    <!-- GameLoom Card -->
    <a
      href="https://github.com/Game-Loom/GameLoom?tab=readme-ov-file"
      target="_blank"
      class="article-link prose prose-linked outline-subtext1/30 from-surface0/10 to-surface0/30 mx-auto
      w-full rounded-xl from-50% p-4 shadow-md outline-1 transition-all duration-300
      hover:outline-hotpink hover:bg-radial hover:shadow-lg
      xl:prose-lg dark:prose-invert flex flex-col"
    >
      <img
        src="/projects/GameLoom/GameLoom1.png"
        alt="GameLoom Thumbnail"
        class="rounded-lg w-full aspect-square object-cover mb-4"
      />
      <h3 class="text-2xl font-bold">GameLoom</h3>
      <p class="text-sm text-subtext0 italic">CS321: Software Engineering</p>
      <p class="text-base text-subtext1 mt-2">
        GameLoom is a personal game library manager that unifies physical and digital game collections across multiple platforms.
      </p>
      <div class="flex gap-2 mt-3 flex-wrap">
        <span class="bg-accent/20 text-accent px-3 py-1 rounded-full text-sm">Java</span>
      </div>
    </a>

    <!-- TeaDo Simulation Card          /projects/TeaDo/report.pdf     /projects/Portfolio/portfolio.pdf#page=5-->  
<div
  class="article-link prose prose-linked outline-subtext1/30 from-surface0/10 to-surface0/30 mx-auto
  w-full rounded-xl from-50% p-4 shadow-md outline-1 transition-all duration-300
  hover:outline-hotpink hover:bg-radial hover:shadow-lg
  xl:prose-lg dark:prose-invert flex flex-col"
>
  <a href="/projects/Portfolio/portfolio.pdf#page=5" target="_blank">
    <img
      src="/projects/TeaDo/TeaDo4.png"
      alt="TeaDo Thumbnail"
      class="rounded-lg w-full aspect-square object-cover mb-4"
    />
  </a>
  <h3 class="text-2xl font-bold">
    <a href="/projects/Portfolio/portfolio.pdf#page=5" target="_blank" class="hover:underline">
      TeaDo Store Simulation
    </a>
  </h3>
  <p class="text-sm text-subtext0 italic">SYST335: Discrete Systems Modeling</p>
  <p class="text-base text-subtext1 mt-2">
    Modeled restaurant operations to reduce customer waiting times, achieving a 20% decrease in customer balking during peak hours.
    The full project report can be found
    <a href="/projects/TeaDo/report.pdf" target="_blank" class="text-accent underline hover:text-info transition">
      here
    </a>.
  </p>
  <div class="flex gap-2 mt-3 flex-wrap">
    <span class="bg-accent/20 text-accent px-3 py-1 rounded-full text-sm">Python</span>
    <span class="bg-accent/20 text-accent px-3 py-1 rounded-full text-sm">Arena Simulation</span>
  </div>
</div>
  </section>
</Layout>
